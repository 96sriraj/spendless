{
  "name": "spendless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The AI agent that spends less, not more. PayPal AI Hackathon entry.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
