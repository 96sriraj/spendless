coverage/

# Screenshots and measurements from the design skill's inspector. Regenerated by
# running `inspect.mjs`, and they are pictures of this app's own UI rather than
# evidence worth reviewing in a diff.
.taste-skill/

# Secrets never belong in a committed file. See AGENTS.md.
.env
.env.*
!.env.example

# `.dev.vars` is wrangler's local-secrets file. It does not exist in the repo
# root, but `@cloudflare/vite-plugin` materialises one inside `dist/<worker>/`
# during a build, populated from `.env`. Verified with `wrangler deploy
# --dry-run`: only `index.js` and a README are uploaded, so it cannot reach
# Cloudflare. Ignored anyway, because "the build wrote a credential to disk"
# should not depend on one flag in one config file staying true.
.dev.vars
.dev.vars.*

*.log
.DS_Store
Thumbs.db

# Written by `bun run spike` and `bun run seed`. They quote live API responses
# and hold order ids, so they are evidence to review and commit deliberately —
# never a file that lands in git by accident.
spike-result.md
seed-state.json